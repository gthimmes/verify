# Next.js (web layer) environment — copy to .env.local and fill in.
#
# Used to build the Google consent URL. Must match the OAuth client whose
# secret the Go API holds. The authorized redirect URI registered in Google
# Cloud Console must be: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=

# Where the Go API lives (defaults to http://localhost:4000 if unset).
# VERIFY_API_URL=http://localhost:4000
