// Verify — Test Case Management System
// Domain model based on docs/spec.md

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Users / auth (mocked single-user in v1; schema is multi-user-ready) ──────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("admin") // org-level: admin | member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects        Project[]       @relation("ProjectOwner")
  authoredTestCases    TestCase[]      @relation("TestCaseCreatedBy")
  updatedTestCases     TestCase[]      @relation("TestCaseUpdatedBy")
  ownedAutomations     TestCase[]      @relation("AutomationOwner")
  ownedRuns            TestRun[]       @relation("RunOwner")
  executedExecutions   TestExecution[] @relation("ExecutedBy")
  auditLogs            AuditLog[]
  membershipsAsUser    ProjectMember[]
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "AIW" — used in case IDs
  name        String
  description String?
  status      String   @default("active") // active | archived
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  areas      Area[]
  testCases  TestCase[]
  templates  TestCaseTemplate[]
  testRuns   TestRun[]
  members    ProjectMember[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String  @default("tester") // admin | manager | tester | viewer

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ─── Areas / Features ────────────────────────────────────────────────────────

model Area {
  id          String   @id @default(cuid())
  projectId   String
  key         String   // short code used in case ID, e.g. "PAY"
  name        String
  description String?
  displayOrder Int     @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features Feature[]

  @@unique([projectId, key])
  @@index([projectId])
}

model Feature {
  id          String   @id @default(cuid())
  areaId      String
  name        String
  description String?
  displayOrder Int     @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  area      Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@index([areaId])
}

// ─── Test Cases ──────────────────────────────────────────────────────────────

model TestCase {
  id            String   @id @default(cuid())
  projectId     String
  featureId     String
  publicId      String   // e.g. "AIW-PAY-0042" — unique within project
  sequenceNum   Int      // for stable ordering within project/area
  title         String
  description   String?
  preconditions String?
  finalExpected String?
  testDataNotes String?

  type           String  @default("functional") // functional | regression | smoke | integration | exploratory | performance | security | accessibility
  priority       String  @default("medium")     // critical | high | medium | low
  status         String  @default("active")     // draft | active | deprecated

  // Automation metadata
  automationStatus  String   @default("not_automated") // not_automated | partial | full
  automationFramework String? // Cypress | Playwright | JUnit | Pytest | Postman | k6 | other
  automationRef     String?   // path or URL
  automationRepoUrl String?
  automationOwnerId String?
  automationLastReviewedAt DateTime?

  // Linkage
  jiraKeys      String? // comma-separated Jira keys (e.g. "PROJ-123,PROJ-124")

  // Audit
  createdById   String
  updatedById   String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature        Feature   @relation(fields: [featureId], references: [id])
  createdBy      User      @relation("TestCaseCreatedBy", fields: [createdById], references: [id])
  updatedBy      User      @relation("TestCaseUpdatedBy", fields: [updatedById], references: [id])
  automationOwner User?    @relation("AutomationOwner", fields: [automationOwnerId], references: [id])

  steps        TestStep[]
  parameters   TestCaseParam[]
  dataRows     TestCaseDataRow[]
  tags         TestCaseTag[]
  attachments  Attachment[]
  relatedTo    TestCaseRelation[] @relation("RelatedFrom")
  relatedFrom  TestCaseRelation[] @relation("RelatedTo")
  versions     TestCaseVersion[]
  snapshots    RunSnapshotCase[]

  @@unique([projectId, publicId])
  @@index([projectId])
  @@index([featureId])
}

model TestStep {
  id           String   @id @default(cuid())
  testCaseId   String
  order        Int
  action       String
  expected     String

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
}

model TestCaseParam {
  id         String @id @default(cuid())
  testCaseId String
  name       String  // e.g. "payment_method"
  order      Int

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, name])
}

model TestCaseDataRow {
  id         String @id @default(cuid())
  testCaseId String
  order      Int
  label      String? // human label e.g. "credit card"
  // values stored as JSON object: { payment_method: "credit_card", ... }
  valuesJson String

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  color String? // optional color hex
  cases TestCaseTag[]
}

model TestCaseTag {
  testCaseId String
  tagId      String
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([testCaseId, tagId])
}

model TestCaseRelation {
  fromId String
  toId   String
  kind   String @default("see_also")
  from   TestCase @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     TestCase @relation("RelatedTo",   fields: [toId],   references: [id], onDelete: Cascade)
  @@id([fromId, toId])
}

model TestCaseVersion {
  id         String   @id @default(cuid())
  testCaseId String
  version    Int
  // snapshot of the case at this version, stored as JSON
  snapshotJson String
  changedById String
  changedAt   DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, version])
}

// ─── Templates ───────────────────────────────────────────────────────────────

model TestCaseTemplate {
  id          String   @id @default(cuid())
  projectId   String?  // null => org-level
  name        String
  description String?
  // serialized JSON containing default fields, steps, params
  bodyJson    String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Attachments ─────────────────────────────────────────────────────────────

model Attachment {
  id            String   @id @default(cuid())
  testCaseId    String?
  executionId   String?
  filename      String
  mimeType      String
  size          Int
  // store inline as base64 for v1 simplicity (real impl: object store)
  dataBase64    String
  uploadedAt    DateTime @default(now())

  testCase  TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  execution TestExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

// ─── Test Runs / Executions ──────────────────────────────────────────────────

model TestRun {
  id          String   @id @default(cuid())
  projectId   String
  parentRunId String?  // for re-run subsets
  name        String
  description String?
  environment String?
  build       String?
  milestone   String?
  status      String   @default("draft") // draft | in_progress | completed | blocked | aborted
  abortReason String?
  ownerId     String
  defaultAssigneeId String?

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User    @relation("RunOwner", fields: [ownerId], references: [id])
  parentRun TestRun? @relation("RunChildren", fields: [parentRunId], references: [id])
  childRuns TestRun[] @relation("RunChildren")

  snapshotCases RunSnapshotCase[]
  executions    TestExecution[]

  @@index([projectId])
}

// Frozen snapshot of a test case (and its steps + data rows) at the moment a run was created.
model RunSnapshotCase {
  id            String  @id @default(cuid())
  runId         String
  testCaseId    String  // pointer back to live case (history navigation)
  publicId      String  // frozen e.g. "AIW-PAY-0042"
  title         String
  description   String?
  preconditions String?
  finalExpected String?
  type          String
  priority      String
  // serialized JSON of {steps: [...], parameters: [...], dataRows: [...]}
  snapshotJson  String
  version       Int

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id])

  executions TestExecution[]

  @@unique([runId, testCaseId])
  @@index([runId])
}

model TestExecution {
  id              String  @id @default(cuid())
  runId           String
  snapshotCaseId  String
  // for parameterized cases — index into the dataRows array (snapshotted)
  dataRowIndex    Int?
  dataRowLabel    String?

  result          String   @default("not_run") // pass | fail | blocked | skipped | not_run
  executedById    String?
  executedAt      DateTime?
  durationSeconds Int?
  envOverride     String?
  buildOverride   String?
  comments        String?
  jiraDefectKeys  String?

  // Step-level results stored as JSON: [{stepId, result, notes}, ...]
  stepResultsJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run          TestRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  snapshotCase RunSnapshotCase @relation(fields: [snapshotCaseId], references: [id], onDelete: Cascade)
  executedBy   User?           @relation("ExecutedBy", fields: [executedById], references: [id])
  attempts     ExecutionAttempt[]
  attachments  Attachment[]

  @@unique([runId, snapshotCaseId, dataRowIndex])
  @@index([runId])
}

// History of prior attempts within the same run/case
model ExecutionAttempt {
  id           String   @id @default(cuid())
  executionId  String
  attemptNum   Int
  result       String
  executedById String?
  executedAt   DateTime
  comments     String?
  durationSeconds Int?

  execution TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   // e.g. "test_case.update", "run.create", "execution.update"
  entity    String   // e.g. "TestCase", "TestRun"
  entityId  String
  beforeJson String?
  afterJson  String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Saved filters / search ──────────────────────────────────────────────────

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String?  // null = team-shared
  projectId String?
  name      String
  scope     String   // "test_cases" | "executions"
  queryJson String
  createdAt DateTime @default(now())
}
