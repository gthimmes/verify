{
  "name": "verify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api": "go -C backend run ./cmd/server",
    "seed": "go -C backend run ./cmd/seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "test:go": "go -C backend test -p 1 ./...",
    "test:go:race": "go -C backend test -p 1 -race ./...",
    "test:go:cover": "go -C backend test -p 1 -coverpkg=./internal/... -coverprofile=coverage.out ./...",
    "e2e": "playwright test --project=golden-paths",
    "e2e:headed": "playwright test --project=golden-paths --headed",
    "e2e:demo": "playwright test --project=demo",
    "test": "npm run lint && npm run test:go && npm run e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "help-navigator": "github:gthimmes/help-navigator",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
